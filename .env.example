# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Usada para gravar imagens no Storage e excluir contas.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuso usado para alertas de prazo — VALIDAÇÃO PENDENTE nº 9.
# America/Sao_Paulo é apenas a recomendação inicial.
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# Janela "vence em breve" — VALIDAÇÃO PENDENTE nº 8.
# Dias antes do prazo (decisão confirmada: 3).
NEXT_PUBLIC_DUE_SOON_DAYS=3
# O próprio dia do vencimento conta como "vence em breve"? (true/false)
NEXT_PUBLIC_DUE_SOON_INCLUDES_DUE_DATE=true

# Envio de convites por e-mail (opcional). Sem chave, o app mostra o link para copiar.
RESEND_API_KEY=
INVITE_FROM_EMAIL=Kanban <convites@seudominio.com>
